# =============================================================================
# PostgreSQL Database Connection & Pool Configuration (Phase DB-3A)
# =============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/souq_aljumla
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SEC=5

# =============================================================================
# Domain-Level Authoritative Routing Flags (Wave 1: All default to 'json')
# Permitted values per domain: 'json' | 'postgres'
# NOTE: Dual-Write is strictly forbidden. Each domain has exactly one authoritative write source.
# =============================================================================
DATA_SOURCE_METADATA=json
DATA_SOURCE_CATALOG_BASE=json
DATA_SOURCE_ACCOUNTS=json
DATA_SOURCE_COMMERCE=json
DATA_SOURCE_FINANCE=json

# =============================================================================
# Web Push VAPID Configuration
# =============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com
